# ===========================================
# AYIN Phase 1: Persistence Configuration
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ayin?schema=public"

# Redis (Session & Challenge Storage)
REDIS_URL="redis://localhost:6379"

# Agent Service Configuration
AGENT_SERVICE_URL="http://localhost:3001"
AGENT_SERVICE_TOKEN="your-secure-service-token"

# x402 Server Configuration
X402_SERVER_URL="http://localhost:4002"
TRUSTED_SIGNERS="0xAddress1,0xAddress2"

# RPC Configuration
RPC_URL="https://base-sepolia-rpc.publicnode.com"

# Authentication
JWT_SECRET="your-production-secret-min-32-chars"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Optional: Cloud Services
# ===========================================

# Vercel Postgres (if using Vercel)
# POSTGRES_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."

# Upstash Redis (if using Upstash)
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
