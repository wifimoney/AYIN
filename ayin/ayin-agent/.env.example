# AYIN Agent Environment Configuration
# Phase 2: Production Hardening

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================

# RPC URL for Base Sepolia (or mainnet)
RPC_URL="https://base-sepolia-rpc.publicnode.com"

# Chain ID
CHAIN_ID=84532

# ===========================================
# AGENT IDENTITY
# ===========================================

# Agent ID (registered in AgentRegistry)
AGENT_ID=1

# Operator private key (for signing, NOT for holding funds)
# In production, use a secure key management service
OPERATOR_KEY="0x..."

# Smart Wallet address (holds funds, enforces policies)
SMART_WALLET_ADDRESS="0x..."

# ===========================================
# CONTRACT ADDRESSES
# ===========================================

# DelegationPolicy contract
DELEGATION_POLICY_ADDRESS="0x..."

# PredictionMarket contract  
PREDICTION_MARKET_ADDRESS="0x..."

# AgentRegistry contract (optional)
AGENT_REGISTRY_ADDRESS="0x..."

# ===========================================
# RISK LIMITS
# ===========================================

# Maximum trade size in wei (default: 1 ETH)
MAX_TRADE_SIZE_WEI=1000000000000000000

# Maximum trades per hour (default: 5)
MAX_TRADES_PER_HOUR=5

# Maximum drawdown percentage (default: 10%)
MAX_DRAWDOWN_PERCENT=10

# Maximum daily volume in wei (default: 10 ETH)
MAX_DAILY_VOLUME_WEI=10000000000000000000

# Maximum gas price in wei (default: 50 gwei)
MAX_GAS_PRICE=50000000000

# ===========================================
# RUNTIME SETTINGS
# ===========================================

# Agent loop interval in ms (default: 60000 = 1 minute)
LOOP_INTERVAL_MS=60000

# Maximum signals to process per loop (default: 3)
MAX_SIGNALS_PER_LOOP=3

# Block confirmations to wait (default: 2)
CONFIRMATIONS=2

# Event polling interval in ms (default: 12000)
POLLING_INTERVAL=12000

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable risk engine (default: true)
ENABLE_RISK_ENGINE=true

# Enable on-chain validation (default: true)  
ENABLE_ONCHAIN_VALIDATION=true

# Enable smart wallet (default: true)
ENABLE_SMART_WALLET=true

# ===========================================
# X402 SERVER
# ===========================================

# x402 data server URL
X402_SERVER_URL="http://localhost:4002"

# x402 server auth token
X402_AUTH_TOKEN="..."

# ===========================================
# OBSERVABILITY
# ===========================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Sentry DSN (optional)
SENTRY_DSN=""
